+static int unix_ring_recvmsg_fast(struct socket *sock, struct msghdr *msg,
+				  size_t size, int flags, bool *handled)
+{
+	struct sock *sk = sock->sk;
+	struct unix_sock *u = unix_sk(sk);
+	struct file *ring_fds[UNIX_RING_FD_MAX];
+	int ring_fd_count = 0;
+	long timeo = -1;
+	bool do_cmsg;
