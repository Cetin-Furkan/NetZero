+static inline void unix_ring_place_linear(u8 *dst_ring, u32 dst_size,
+					  u32 dst_mask, u64 seq,
+					  const u8 *src, size_t seg_len)
+{
+	u32 dst_off = (u32)seq & dst_mask;
+	size_t first = min_t(size_t, seg_len, dst_size - dst_off);
+
+	nz_avx512_kcopy(dst_ring + dst_off, src, first);
+	if (seg_len > first)
+		nz_avx512_kcopy(dst_ring, src + first, seg_len - first);
+}
+
+static void unix_ring_try_expand(struct sock *other, struct unix_ring *ring)
+{
+	struct unix_sock *otheru = unix_sk(other);
+	unsigned int new_order = UNIX_RING_MAX_ORDER;
+	struct page *new_pages, *old_pages = NULL;
+	unsigned int old_order = 0;
+	u32 new_size, new_mask;
+	u8 *new_buf;
+
+	if (READ_ONCE(ring->order) >= UNIX_RING_MAX_ORDER)
+		return;
+
+	new_pages = alloc_pages(GFP_KERNEL_ACCOUNT | __GFP_NOWARN | __GFP_COMP,
+				new_order);
+	if (!new_pages) {
+		new_order = UNIX_RING_MID_ORDER;
+		if (READ_ONCE(ring->order) >= new_order)
+			return;
+		new_pages = alloc_pages(GFP_KERNEL_ACCOUNT | __GFP_NOWARN | __GFP_COMP,
+					new_order);
+		if (!new_pages)
+			return;
+	}
+
+	new_buf = page_address(new_pages);
+	new_size = PAGE_SIZE << new_order;
+	new_mask = new_size - 1;
+
+	mutex_lock(&ring->prod_lock);
+	if (unlikely(!ring->buf || ring->order >= new_order ||
+		     sock_flag(other, SOCK_DEAD) ||
+		     (READ_ONCE(other->sk_shutdown) & RCV_SHUTDOWN))) {
+		mutex_unlock(&ring->prod_lock);
+		__free_pages(new_pages, new_order);
+		return;
+	}
+
+	/*
+	 * Acquire consumer iolock via non-blocking trylock to guarantee zero
+	 * concurrent readers during live buffer swap with zero deadlock risk.
+	 */
+	if (!mutex_trylock(&otheru->iolock)) {
+		mutex_unlock(&ring->prod_lock);
+		__free_pages(new_pages, new_order);
+		return;
+	}
+
+	{
+		u64 tail = ring->tail;
+		u64 head = ring->head;
+		u64 used = head > tail ? head - tail : 0;
+
+		if (used) {
+			u32 old_off = (u32)tail & ring->mask;
+			size_t first = min_t(size_t, (size_t)used,
+					     ring->size - old_off);
+
+			unix_ring_place_linear(new_buf, new_size, new_mask,
+					       tail, ring->buf + old_off, first);
+			if (used > first)
