+		*handled = true;
+		return -EFAULT;
+	}
+
+	ring = unix_ring_get_or_alloc(other, len);
+	if (unlikely(!ring)) {
+		*handled = false;
+		return 0;
+	}
+
+	*handled = true;
+	return unix_ring_send_ubuf(sk, other, ring, ubuf, len, flags);
+}
