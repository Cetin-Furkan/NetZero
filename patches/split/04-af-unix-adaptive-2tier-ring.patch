+static struct unix_ring *unix_ring_get_or_alloc(struct sock *other,
+						size_t hint_len)
+{
+	struct unix_sock *otheru = unix_sk(other);
+	struct unix_ring *ring = smp_load_acquire(&otheru->rx_ring);
+	struct page *pages = NULL;
+	unsigned int order;
+
+	if (likely(ring)) {
+		if (unlikely(hint_len > UNIX_RING_BULK_THRESH &&
+			     READ_ONCE(ring->order) < UNIX_RING_MAX_ORDER))
+			unix_ring_try_expand(other, ring);
+		return ring;
+	}
+
+	ring = kzalloc(sizeof(*ring), GFP_KERNEL_ACCOUNT);
+	if (!ring)
+		return NULL;
+
+	if (hint_len > UNIX_RING_BULK_THRESH) {
+		order = UNIX_RING_MAX_ORDER;
+		pages = alloc_pages(GFP_KERNEL_ACCOUNT | __GFP_NOWARN | __GFP_COMP, order);
+		if (!pages) {
+			order = UNIX_RING_MID_ORDER;
+			pages = alloc_pages(GFP_KERNEL_ACCOUNT | __GFP_NOWARN | __GFP_COMP, order);
+		}
+	}
+	if (!pages) {
+		order = UNIX_RING_INIT_ORDER;
+		pages = alloc_pages(GFP_KERNEL_ACCOUNT | __GFP_NOWARN | __GFP_COMP, order);
+		if (!pages) {
+			kfree(ring);
+			return NULL;
+		}
+	}
+
+	ring->pages = pages;
+	ring->buf = page_address(pages);
+	ring->order = order;
+	ring->size = PAGE_SIZE << order;
+	ring->mask = ring->size - 1;
+	mutex_init(&ring->prod_lock);
+
+	unix_state_lock(other);
+	if (unlikely(sock_flag(other, SOCK_DEAD) ||
+		     (other->sk_shutdown & RCV_SHUTDOWN))) {
+		unix_state_unlock(other);
+		__free_pages(pages, order);
+		kfree(ring);
+		return NULL;
+	}
+	if (unlikely(otheru->rx_ring)) {
+		struct unix_ring *existing = otheru->rx_ring;
+
+		unix_state_unlock(other);
+		__free_pages(pages, order);
+		kfree(ring);
+		return existing;
+	}
+	smp_store_release(&otheru->rx_ring, ring);
+	unix_state_unlock(other);
+	return ring;
+}
