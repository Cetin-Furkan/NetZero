+static int tcp_sack_try_bmap(struct sock *sk, struct sk_buff *skb,
+			     struct tcp_sacktag_state *state,
+			     u32 start_seq, u32 end_seq, bool dup_sack)
+{
+	struct tcp_skb_cb *scb = TCP_SKB_CB(skb);
+	struct tcp_sock *tp = tcp_sk(sk);
+	unsigned int pcount = tcp_skb_pcount(skb);
+	unsigned int mss, s_off, e_off, s_seg, e_seg;
+	u32 full_mask, e_mask, bmap, new_bits;
+
+	if (pcount <= 1 || pcount > 32 || dup_sack)
+		return 0;
+	if (!after(scb->end_seq, start_seq) || !before(scb->seq, end_seq))
+		return 0;
+	if (!after(start_seq, scb->seq) && !before(end_seq, scb->end_seq))
+		return 1;
+	if (scb->sacked & (TCPCB_SACKED_ACKED | TCPCB_SACKED_RETRANS |
+			   TCPCB_LOST | TCPCB_RETRANS))
+		return 0;
