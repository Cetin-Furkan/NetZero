+static inline u8 inet_ehash_h2(u32 hash)
+{
+	/*
+	 * NetZero v2: Orthogonal GF(2) Castagnoli CRC32C H2 fingerprint
+	 * (3-cycle Willow Cove Port 1 crc32l, zero FPU usage).
+	 */
+	u8 tag = (u8)(nz_crc32c_u32(0x9e3779b9U, hash) >> 24);
+
+	return tag ? tag : 0x80;
+}
+
+static inline void inet_ehash_prepend_tag(struct inet_ehash_bucket *head,
+					  u32 hash)
+{
+	u64 old_tags = READ_ONCE(head->swar_tags);
+	u64 overflow = (old_tags >> 48) ? (0xFFULL << 56) : 0;
+	u64 new_tags = ((old_tags << 8) & 0x00FFFFFFFFFFFF00ULL) |
+		       inet_ehash_h2(hash) | overflow;
+
+	WRITE_ONCE(head->swar_tags, new_tags);
+	smp_wmb();
+}
+
+static inline void inet_ehash_rebuild_tags(struct inet_ehash_bucket *head)
+{
+	const struct hlist_nulls_node *node;
+	const struct sock *esk;
+	u64 tags = 0;
+	int n = 0;
+
+	sk_nulls_for_each(esk, node, &head->chain) {
+		if (n == 7) {
+			tags |= 0xFFULL << 56;
+			break;
+		}
+		tags |= (u64)inet_ehash_h2(esk->sk_hash) << (n * 8);
+		n++;
+	}
+	smp_store_release(&head->swar_tags, tags);
+}
+
+static inline bool inet_ehash_may_contain(const struct inet_ehash_bucket *head,
+					  u32 hash)
+{
+	u64 tags = READ_ONCE(head->swar_tags);
+	u64 pat, x;
+
+	if (!tags)
+		return false;
+	if (unlikely((tags >> 56) == 0xFF))
+		return true;
+	pat = (u64)inet_ehash_h2(hash) * 0x0101010101010101ULL;
+	x = tags ^ pat;
+	return ((x - 0x0101010101010101ULL) & ~x & 0x8080808080808080ULL) != 0;
+}
